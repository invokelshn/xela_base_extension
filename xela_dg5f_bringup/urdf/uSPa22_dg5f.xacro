<?xml version="1.0"?>
<robot name="dg_uSPa22" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- uSPa22 dg-5f model -->
  <xacro:arg name="base_prefix" default="base_" />

  <xacro:macro name="dg_uSPa22" params="sequence parent x:=0.0 y:=0.0 z:=0.0 rx:=0.0 ry:=0.0 rz:=0.0 col:='blue' body:=1 taxels:=1 skipinertia:=0 xoff=-0.0009 yoff=0.0011 zoff=0.003 txstep=0.0046666 tystep=0.00466666 standalone:=0 sensor_collision:=1 mesh_x:=0.0 mesh_y:=0.0 mesh_z:=0.0 mesh_rz:=90 taxel_rz:=0 sensor_prefix:=''">
    <!-- sensor_prefix: see dg5f_fingertip.xacro's own comment on this param. -->


    <xacro:if value="${standalone == 1}">
      <xacro:include filename="$(find xela_dg5f_bringup)/urdf/materials.xacro" />
      <xacro:include filename="$(find xela_dg5f_bringup)/urdf/taxel.xacro" />
    </xacro:if>

    <xacro:property name="bseq" value="$(arg base_prefix)${sequence}"/>

    <joint name="${bseq}_uSPa22_fixed" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${radians(rx)} ${radians(ry)} ${radians(rz)}"/>
      <parent link="${parent}" />
      <child link="${bseq}_uSPa22_link" />
    </joint>
    <!--
      dg_uspa22_base.stl vertices were recentered in-place (2026-08-08): the
      former per-axis reference point (x_center,y_center,z_min) was baked
      directly into the mesh via trimesh apply_transform+export, removing
      the large CAD-assembly translation that used to live in mesh_x/y/z
      (this fixed a visible sensor-detachment bug that got lever-arm
      amplified when the parent joint bends ~80deg). Only the in-plane
      mesh_rz spin remains as a URDF-level parameter (pure rotation about
      the now-centered mesh origin, xyz stays 0 0 0): this is what lets
      the SAME recentered mesh serve both the standard fingers (mesh_rz=90)
      and the thumb (mesh_rz=0) with no translation needed either way.
    -->
    <link name="${bseq}_uSPa22_link">
      <collision>
        <origin xyz="${mesh_x} ${mesh_y} ${mesh_z}" rpy="0 0 ${radians(mesh_rz)}" />
        <geometry>
          <mesh filename="package://xela_dg5f_bringup/mesh/dg_uspa22_base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <xacro:if value="${body == 1}">
        <visual>
          <origin xyz="${mesh_x} ${mesh_y} ${mesh_z}" rpy="0 0 ${radians(mesh_rz)}" />
          <geometry>
            <mesh filename="package://xela_dg5f_bringup/mesh/dg_uspa22_base.stl" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="${col}"/>
        </visual>
        <xacro:unless value="${skipinertia == 1}">
          <inertial>
            <mass value="0.0036" />
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="5.76e-09" ixy="0.0" ixz="0.0" iyy="6.55e-09" iyz="1.44e-10" izz="1.20e-08" />
          </inertial>
        </xacro:unless>
      </xacro:if>
    </link>

    <gazebo reference="${bseq}_uSPa22_link">
      <material>Gazebo/Green</material>
    </gazebo>

    <!--
      Taxel xyz below were measured directly off the mesh: found the 4
      raised bump tips on dg_uspa22_base.stl (kmeans clustering of the
      near-top-Z vertices), recentered the same way as the visual/collision
      origin above (center X/Y, z_min, then a Rz(90) spin), so each
      taxel sits exactly on its physical bump instead of an approximate
      grid formula. The literal x/y below are in that original Rz(90) frame;
      when mesh_rz differs (e.g. the thumb's Rz(0) variant), an extra
      Rz(mesh_rz - 90) is applied here so the taxels stay locked to the
      mesh's bumps under any mesh_rz.
      taxel_rz additionally spins each taxel's OWN prismatic-joint frame
      about its local Z (the sensing/push axis, unaffected by a pure Z
      rotation) without moving its position; the taxel's visual is a
      symmetric sphere, so this only affects the TF axes shown in RViz.
      Used to align the thumb's taxel frame convention (previously Y
      pointed toward the fingertip) with the other fingers' (2026-08-05).
    -->
    <xacro:property name="dtheta" value="${radians(mesh_rz - 90)}" />
    <xacro:if value="${taxels == 1}">
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa22_01" x="${0.002459*cos(dtheta) - (-0.002547)*sin(dtheta)}" y="${0.002459*sin(dtheta) + (-0.002547)*cos(dtheta)}" z="0.004939" rz="${taxel_rz}" parent="${bseq}_uSPa22_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa22_02" x="${0.002431*cos(dtheta) - 0.002148*sin(dtheta)}"    y="${0.002431*sin(dtheta) + 0.002148*cos(dtheta)}"    z="0.004939" rz="${taxel_rz}" parent="${bseq}_uSPa22_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa22_03" x="${-0.002241*cos(dtheta) - (-0.002547)*sin(dtheta)}" y="${-0.002241*sin(dtheta) + (-0.002547)*cos(dtheta)}" z="0.004939" rz="${taxel_rz}" parent="${bseq}_uSPa22_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa22_04" x="${-0.002269*cos(dtheta) - 0.002148*sin(dtheta)}"   y="${-0.002269*sin(dtheta) + 0.002148*cos(dtheta)}"   z="0.004939" rz="${taxel_rz}" parent="${bseq}_uSPa22_link" sensor_collision="${sensor_collision}" />
    </xacro:if>
  </xacro:macro>

</robot>

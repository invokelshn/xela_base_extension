<?xml version="1.0"?>
<robot name="dg_uSPa46" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- uSPa46 dg-5f model -->
  <xacro:arg name="base_prefix" default="base_" />

  <xacro:macro name="dg_uSPa46" params="sequence parent x:=0.0 y:=0.0 z:=0.0 rx:=0.0 ry:=0.0 rz:=0.0 col:='blue' body:=1 taxels:=1 skipinertia:=0 xoff:=-0.0252 yoff:=0.0178 zoff:=0.005 txstep:=0.00724 tystep:=0.00717 standalone:=0 sensor_collision:=1 sensor_prefix:=''">
    <!-- sensor_prefix: see dg5f_fingertip.xacro's own comment on this param. -->


    <xacro:if value="${standalone == 1}">
      <xacro:include filename="$(find xela_dg5f_bringup)/urdf/materials.xacro" />
      <xacro:include filename="$(find xela_dg5f_bringup)/urdf/taxel.xacro" />
    </xacro:if>

    <xacro:property name="bseq" value="$(arg base_prefix)${sequence}"/>

    <joint name="${bseq}_uSPa46_fixed" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${radians(rx)} ${radians(ry)} ${radians(rz)}"/>
      <parent link="${parent}" />
      <child link="${bseq}_uSPa46_link" />
    </joint>
    <!--
      dg_uspa46_base.stl vertices were recentered in-place (2026-08-08) by
      baking the formerly-hardcoded origin (xyz="0.000338 0.143004 -0.159444"
      rpy="0 -90 0", including the mesh-axis permutation rotation) directly
      into the mesh data (trimesh apply_transform+export). This removes the
      raw CAD-assembly offset that used to live in the visual/collision
      origin. Origin is now identity.
    -->
    <link name="${bseq}_uSPa46_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://xela_dg5f_bringup/mesh/dg_uspa46_base.stl" scale="0.001 0.001 0.001" />
        </geometry>
      </collision>
      <xacro:if value="${body == 1}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://xela_dg5f_bringup/mesh/dg_uspa46_base.stl" scale="0.001 0.001 0.001" />
          </geometry>
          <material name="${col}"/>
        </visual>
        <xacro:unless value="${skipinertia == 1}">
          <inertial>
            <mass value="0.0108" />
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1.11e-07" ixy="0.0" ixz="0.0" iyy="2.97e-07" iyz="0.0" izz="4.03e-07" />
          </inertial>
        </xacro:unless>
      </xacro:if>
    </link>

    <gazebo reference="${bseq}_uSPa46_link">
      <material>Gazebo/Red</material>
    </gazebo>

    <xacro:if value="${taxels == 1}">
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_01" x="${4*tystep-yoff}" y="${1*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_02" x="${4*tystep-yoff}" y="${2*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_03" x="${4*tystep-yoff}" y="${3*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_04" x="${4*tystep-yoff}" y="${4*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_05" x="${4*tystep-yoff}" y="${5*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_06" x="${4*tystep-yoff}" y="${6*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_07" x="${3*tystep-yoff}" y="${1*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_08" x="${3*tystep-yoff}" y="${2*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_09" x="${3*tystep-yoff}" y="${3*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_10" x="${3*tystep-yoff}" y="${4*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_11" x="${3*tystep-yoff}" y="${5*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_12" x="${3*tystep-yoff}" y="${6*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_13" x="${2*tystep-yoff}" y="${1*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_14" x="${2*tystep-yoff}" y="${2*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_15" x="${2*tystep-yoff}" y="${3*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_16" x="${2*tystep-yoff}" y="${4*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_17" x="${2*tystep-yoff}" y="${5*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_18" x="${2*tystep-yoff}" y="${6*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_19" x="${1*tystep-yoff}" y="${1*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_20" x="${1*tystep-yoff}" y="${2*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_21" x="${1*tystep-yoff}" y="${3*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_22" x="${1*tystep-yoff}" y="${4*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_23" x="${1*tystep-yoff}" y="${5*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
      <xacro:taxel sequence="${sensor_prefix}${sequence}_uSPa46_24" x="${1*tystep-yoff}" y="${6*txstep+xoff}" z="${zoff}" parent="${bseq}_uSPa46_link" sensor_collision="${sensor_collision}" />
    </xacro:if>
  </xacro:macro>

</robot>
